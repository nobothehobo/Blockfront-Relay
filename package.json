{
  "name": "blockfront-relay",
  "version": "2.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/node.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-node.mjs",
    "start": "node dist/node/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "build:hosted": "npm run build && node scripts/build-worker.mjs",
    "db:generate": "drizzle-kit generate",
    "test:browser": "node --import tsx tests/browser.ts",
    "test:elimination": "node --import tsx tests/elimination-browser.ts",
    "test:polish": "node --import tsx tests/polish-browser.ts",
    "test:fieldwork": "node --import tsx tests/fieldwork-browser.ts",
    "test:audio": "node --import tsx tests/audio-browser.ts",
    "test:connection": "node --import tsx tests/connection-browser.ts",
    "test:frontline": "node --import tsx tests/frontline-browser.ts",
    "test:strongholds": "node --import tsx tests/strongholds-browser.ts",
    "test:banner": "node --import tsx tests/banner-browser.ts",
    "format": "prettier --write client server shared worker/index.ts worker/assets.generated.d.ts tests docs db scripts/*.mjs *.json *.md *.yaml",
    "test:graphics": "node --import tsx tests/graphics-browser.ts",
    "test:night": "node --import tsx tests/night-browser.ts"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
